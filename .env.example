# dbmate settings for migrations executing
DBMATE_MIGRATIONS_DIR=./storage/db/migrations
DATABASE_URL="the connection string to db"

# Superuser: owns the DB, used only for migrations/admin
POSTGRES_USER="the db superuser name"
POSTGRES_PASSWORD="the db superuser pass"
POSTGRES_DB="the db to use"

# Limited user for the service (SELECT/INSERT/UPDATE/DELETE only)
POSTGRES_APP_USER="the app db user"
POSTGRES_APP_PASSWORD="the app db user pass"

# Dev only: insert 3 random books + 3 random articles once (created by the admin). Use "false" in production.
SEED_TEST_DATA="true"

# Service jwt key
JWT_SECRET="secret key for JWT"

# First-start admin account for the platform (used by init.sql)
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASS_HASH='the password hash pade with password_hash()'

# SMTP settings
MAIL_HOST="smtp host"
MAIL_PORT="smtp port"
MAIL_USERNAME="smtp login"
MAIL_PASSWORD="smtp password"
MAIL_ENCRYPTION="tls | ssl"
MAIL_FROM="the mail to be used to send emails"
MAIL_FROM_NAME="the name of service that sends emails DEFAULT: LoreBook"